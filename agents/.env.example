# Local development settings for agents/01_agents_stack.yml (which also
# starts the data_platform stack). Copy to agents/.env (git-ignored);
# Docker Compose reads it automatically. Every variable is optional.

# Agent LLM: none | anthropic | openai | ollama. "none" uses the
# deterministic fallbacks, which is what CI runs.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Where a local Ollama server runs, for LLM_PROVIDER=ollama.
OLLAMA_URL=http://host.docker.internal:11434

# Minimum mean composite score for agents/03_eval_harness.py.
EVAL_MIN_SCORE=0.6
