{
  "uid": "aidataboon-pipeline-health",
  "title": "AIDataBoon / Pipeline Health",
  "tags": [
    "aidataboon"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingestion lag by source",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aidataboon_ingestion_lag_seconds",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transform duration p95 by layer",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aidataboon_transform_duration_seconds_bucket[15m])) by (le, layer))",
          "legendFormat": "{{layer}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pipeline success rate (1h)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(aidataboon_pipeline_runs_total{status=\"success\"}[1h])) / sum(rate(aidataboon_pipeline_runs_total[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pipeline runs by status (rate)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pipeline, status) (rate(aidataboon_pipeline_runs_total[15m]))",
          "legendFormat": "{{pipeline}} / {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
