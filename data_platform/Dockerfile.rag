# syntax=docker/dockerfile:1
# =============================================================================
# AIDataBoon RAG API: container image for 05_rag_service.py
#
# Build context is data_platform/ (this directory):
#   docker compose -f 01_local_stack.yml build rag-api
#   docker build -f Dockerfile.rag -t aidataboon/rag-api:dev .
#
# Used by 10_cicd_pipeline.yml to build and push the image deployed to
# Render (primary, via render.yaml Blueprint) and/or ECR/ECS
# (08_terraform_aws.tf, optional).
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1 (builder): install Python deps into a venv
# ---------------------------------------------------------------------------
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS builder

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-rag.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-rag.txt

# Bake the ONNX models into the image so a cold start never downloads
# them. /opt/models, not /app/models: 01_local_stack.yml mounts a volume
# over /app/models, which would hide them.
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARG RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RUN python -c "import sys; \
from fastembed import TextEmbedding; \
from fastembed.rerank.cross_encoder import TextCrossEncoder; \
TextEmbedding(sys.argv[1], cache_dir='/opt/models'); \
TextCrossEncoder(sys.argv[2], cache_dir='/opt/models')" \
    "${EMBEDDING_MODEL}" "${RERANKER_MODEL}"

# ---------------------------------------------------------------------------
# Stage 2 (runtime): slim image, non-root user, curl for healthchecks
# ---------------------------------------------------------------------------
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS runtime

RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash appuser
WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=appuser:appuser /opt/models /opt/models
COPY 05_rag_service.py .

# /app/data: optional local Gold-layer parquet fallback.
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# HF_HUB_OFFLINE: the models are in /opt/models, so never call the Hub.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    WORKERS=2 \
    MODEL_CACHE_DIR=/opt/models \
    HF_HUB_OFFLINE=1

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD exec uvicorn 05_rag_service:app --host 0.0.0.0 --port "${PORT}" --workers "${WORKERS}"
