# Local development settings for data_platform/01_local_stack.yml.
# Copy to data_platform/.env (git-ignored) and fill in what you need;
# Docker Compose reads it automatically. Every variable is optional: the
# stack falls back to local-only defaults, which must not be used outside
# your machine.

# Airflow: set your own keys instead of the built-in development defaults.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
#   openssl rand -hex 32
AIRFLOW_SECRET_KEY=

# GitHub token for a higher rate limit on the trending scrape (no scopes needed).
GITHUB_TOKEN=

# Answer generation for the RAG API: none | anthropic | openai.
LLM_PROVIDER=none
# Needed for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Needed for LLM_PROVIDER=openai.
OPENAI_API_KEY=
